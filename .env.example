# Supabase connection (server-side service role recommended for ingestion)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Logical table names used by the ingestion / analytics layer
SUPABASE_LISTINGS_TABLE=listings

# API behaviour
APP_NAME=Moldova AVM
APP_ENV=development
ALLOWED_ORIGINS=*

# Scraper politeness
SCRAPER_USER_AGENT=MoldovaAVM/1.0 (+https://example.com)
SCRAPER_REQUEST_TIMEOUT=20
